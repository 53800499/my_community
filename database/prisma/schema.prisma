// ==============================================================================
// My Community — Schéma Prisma Centralisé (PostgreSQL 16+)
// Réf: ADR-003, ADR-004, ADR-006 & docs/database/schema-modernise-postgresql.md
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
}

enum TerritoryType {
  COUNTRY
  DEPARTMENT
  COMMUNE
  ARRONDISSEMENT
  VILLAGE_QUARTIER
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum CommunityRole {
  MEMBER
  MODERATOR
  MANAGER
  ADMIN
}

enum AssociationRole {
  MEMBER
  PRESIDENT
  SECRETARY
  TREASURER
  BOARD_MEMBER
}

enum PostVisibility {
  PUBLIC
  COMMUNITY
  ASSOCIATION_MEMBERS
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReactionType {
  LIKE
  LOVE
  CELEBRATE
  SUPPORT
  INSIGHTFUL
}

enum ReactionTargetType {
  POST
  COMMENT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  POSTED
  CANCELLED
}

enum NotificationType {
  INFO
  ALERT
  MEMBERSHIP_REQUEST
  COMMUNITY_STATUS
  SYSTEM
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum OccupationStatus {
  PENDING
  ACTIVE
  TERMINATED
  CANCELLED
}

// ------------------------------------------------------------------------------
// DOMAINE 1: IDENTITY & USERS
// ------------------------------------------------------------------------------

model UserAccount {
  id           String        @id @default(uuid()) @db.Uuid
  email        String?       @unique @db.VarChar(255)
  phoneNumber  String        @unique @map("phone_number") @db.VarChar(32)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile             UserProfile?
  proposalsSubmitted  CommunityProposal[]     @relation("ProposedBy")
  proposalsReviewed   CommunityProposal[]     @relation("ReviewedBy")
  memberships         CommunityMembership[]
  posts               Post[]
  comments            Comment[]
  reactions           Reaction[]
  recordedTransactions FinancialTransaction[] @relation("RecordedBy")
  notifications       Notification[]
  associationMemberships AssociationMember[]
  roomOccupations     RoomOccupation[]
  integrationFeeDues  IntegrationFeeDue[]
  recordedIntegrationFeePayments IntegrationFeePayment[] @relation("IntegrationFeeRecordedBy")
  recordedExpenses    Expense[] @relation("ExpenseRecordedBy")
  organizedEvents     CommunityEvent[]
  eventRegistrations  CommunityEventRegistration[]

  @@map("user_accounts")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String   @map("first_name") @db.VarChar(100)
  lastName  String   @map("last_name") @db.VarChar(100)
  avatarKey String?  @map("avatar_key") @db.VarChar(255)
  bio       String?  @db.Text
  city      String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ------------------------------------------------------------------------------
// DOMAINE 2: TERRITORIES
// ------------------------------------------------------------------------------

model Territory {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(150)
  code      String        @unique @db.VarChar(50)
  type      TerritoryType
  parentId  String?       @map("parent_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  parent      Territory?          @relation("TerritoryHierarchy", fields: [parentId], references: [id])
  children    Territory[]         @relation("TerritoryHierarchy")
  communities Community[]
  proposals   CommunityProposal[]

  @@map("territories")
}

// ------------------------------------------------------------------------------
// DOMAINE 3: COMMUNITIES & PROPOSALS
// ------------------------------------------------------------------------------

model CommunityProposal {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(150)
  description   String         @db.Text
  justification String         @db.Text
  territoryId   String         @map("territory_id") @db.Uuid
  proposedById  String         @map("proposed_by_id") @db.Uuid
  status        ProposalStatus @default(PENDING)
  reviewedById  String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?      @map("rejection_reason") @db.Text
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  territory  Territory    @relation(fields: [territoryId], references: [id])
  proposedBy UserAccount  @relation("ProposedBy", fields: [proposedById], references: [id])
  reviewedBy UserAccount? @relation("ReviewedBy", fields: [reviewedById], references: [id])
  community  Community?

  @@map("community_proposals")
}

model Community {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(150)
  slug               String   @unique @db.VarChar(160)
  description        String?  @db.Text
  territoryId        String   @map("territory_id") @db.Uuid
  approvedProposalId String?  @unique @map("approved_proposal_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  territory        Territory               @relation(fields: [territoryId], references: [id])
  approvedProposal CommunityProposal?      @relation(fields: [approvedProposalId], references: [id])
  memberships      CommunityMembership[]
  associations     AssociationCommunity[]
  posts            Post[]
  events           CommunityEvent[]

  @@map("communities")
}

// ------------------------------------------------------------------------------
// DOMAINE 4: MEMBERSHIPS
// ------------------------------------------------------------------------------

model CommunityMembership {
  id          String           @id @default(uuid()) @db.Uuid
  communityId String           @map("community_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      MembershipStatus @default(PENDING)
  joinedAt    DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  community Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      UserAccount               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     CommunityMembershipRole[]

  @@unique([communityId, userId])
  @@map("community_memberships")
}

model CommunityMembershipRole {
  id           String        @id @default(uuid()) @db.Uuid
  membershipId String        @map("membership_id") @db.Uuid
  role         CommunityRole @default(MEMBER)

  membership CommunityMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, role])
  @@map("community_membership_roles")
}

// ------------------------------------------------------------------------------
// DOMAINE 5: ASSOCIATIONS (N-N avec les Communautés)
// ------------------------------------------------------------------------------

model Association {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String   @db.VarChar(200)
  acronym            String?  @db.VarChar(50)
  registrationNumber String?  @unique @map("registration_number") @db.VarChar(100)
  description        String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  communities  AssociationCommunity[]
  members      AssociationMember[]
  transactions FinancialTransaction[]
  quarters     Quarter[]
  roomOccupations RoomOccupation[]
  cotisations  Cotisation[]
  buildingLeases BuildingLease[]
  integrationFeePlans IntegrationFeePlan[]
  donations    Donation[]
  expenses     Expense[]

  @@map("associations")
}

model AssociationCommunity {
  id            String   @id @default(uuid()) @db.Uuid
  associationId String   @map("association_id") @db.Uuid
  communityId   String   @map("community_id") @db.Uuid
  linkedAt      DateTime @default(now()) @map("linked_at") @db.Timestamptz(6)

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([associationId, communityId])
  @@map("association_communities")
}

model AssociationMember {
  id            String          @id @default(uuid()) @db.Uuid
  associationId String          @map("association_id") @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  role          AssociationRole @default(MEMBER)
  joinedAt      DateTime        @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  association Association  @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user        UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cotisations Cotisation[]

  @@unique([associationId, userId])
  @@map("association_members")
}

// ------------------------------------------------------------------------------
// DOMAINE 6: SOCIAL (Posts, Publications)
// ------------------------------------------------------------------------------

model Post {
  id          String         @id @default(uuid()) @db.Uuid
  communityId String         @map("community_id") @db.Uuid
  authorId    String         @map("author_id") @db.Uuid
  title       String         @db.VarChar(255)
  content     String         @db.Text
  visibility  PostVisibility @default(COMMUNITY)
  publishedAt DateTime       @default(now()) @map("published_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  community Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    UserAccount @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@map("posts")
}

model Comment {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @map("post_id") @db.Uuid
  authorId  String        @map("author_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  content   String        @db.Text
  status    CommentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  post    Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  UserAccount @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]   @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Reaction {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  targetType ReactionTargetType @map("target_type")
  targetId   String             @map("target_id") @db.Uuid
  type       ReactionType       @default(LIKE)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("reactions")
}

// ------------------------------------------------------------------------------
// DOMAINE 7: FINANCE (Transactions immuables en XOF - ADR-006)
// ------------------------------------------------------------------------------

model FinancialTransaction {
  id            String            @id @default(uuid()) @db.Uuid
  associationId String?           @map("association_id") @db.Uuid
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("XOF") @db.Char(3)
  type          TransactionType
  status        TransactionStatus @default(POSTED)
  reference     String?           @unique @db.VarChar(100)
  description   String?           @db.Text
  category      String?           @db.VarChar(100)
  paymentMethod String?           @map("payment_method") @db.VarChar(50)
  recordedById  String            @map("recorded_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  association             Association?            @relation(fields: [associationId], references: [id])
  recordedBy              UserAccount             @relation("RecordedBy", fields: [recordedById], references: [id])
  integrationFeePayments  IntegrationFeePayment[]
  buildingRentExpenses    BuildingRentExpense[]
  cotisations             Cotisation[]
  donations               Donation[]
  expenses                Expense[]

  @@map("financial_transactions")
}

model Cotisation {
  id            String                @id @default(uuid()) @db.Uuid
  associationId String                @map("association_id") @db.Uuid
  memberId      String                @map("member_id") @db.Uuid
  amount        Decimal               @db.Decimal(12, 2)
  currency      String                @default("XOF") @db.Char(3)
  period        String                @db.VarChar(50)
  status        String                @default("PAID") @db.VarChar(20)
  paymentMethod String                @default("MOBILE_MONEY") @map("payment_method") @db.VarChar(50)
  reference     String?               @db.VarChar(100)
  transactionId String?               @map("transaction_id") @db.Uuid
  notes         String?               @db.Text
  paidAt        DateTime              @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  association   Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  member        AssociationMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([associationId, period])
  @@index([memberId])
  @@map("cotisations")
}

model BuildingLease {
  id                 String                @id @default(uuid()) @db.Uuid
  buildingId         String                @unique @map("building_id") @db.Uuid
  associationId      String                @map("association_id") @db.Uuid
  monthlyRentAmount  Decimal               @map("monthly_rent_amount") @db.Decimal(12, 2)
  currency           String                @default("XOF") @db.Char(3)
  paymentDayOfMonth  Int                   @default(5) @map("payment_day_of_month")
  leaseStartDate     DateTime              @map("lease_start_date") @db.Date
  leaseEndDate       DateTime?             @map("lease_end_date") @db.Date
  isActive           Boolean               @default(true) @map("is_active")
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  building           Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  association        Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  rentExpenses       BuildingRentExpense[]

  @@map("building_leases")
}

model BuildingRentExpense {
  id            String                @id @default(uuid()) @db.Uuid
  leaseId       String                @map("lease_id") @db.Uuid
  monthYear     String                @map("month_year") @db.VarChar(7)
  amount        Decimal               @db.Decimal(12, 2)
  status        String                @default("PENDING") @db.VarChar(20)
  transactionId String?               @map("transaction_id") @db.Uuid
  dueDate       DateTime              @map("due_date") @db.Date
  paidAt        DateTime?             @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  lease         BuildingLease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([leaseId, monthYear])
  @@map("building_rent_expenses")
}

model IntegrationFeePlan {
  id                  String                @id @default(uuid()) @db.Uuid
  associationId       String                @map("association_id") @db.Uuid
  academicYear        String                @map("academic_year") @db.VarChar(20)
  name                String                @db.VarChar(100)
  amount              Decimal               @db.Decimal(12, 2)
  currency            String                @default("XOF") @db.Char(3)
  installmentsAllowed Int                   @default(2) @map("installments_allowed")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  association         Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  dues                IntegrationFeeDue[]

  @@unique([associationId, academicYear])
  @@map("integration_fee_plans")
}

model IntegrationFeeDue {
  id            String                  @id @default(uuid()) @db.Uuid
  occupationId  String                  @unique @map("occupation_id") @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  planId        String                  @map("plan_id") @db.Uuid
  totalAmount   Decimal                 @map("total_amount") @db.Decimal(12, 2)
  paidAmount    Decimal                 @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status        String                  @default("PENDING") @db.VarChar(20)
  dueDate       DateTime                @map("due_date") @db.Date
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  occupation    RoomOccupation          @relation(fields: [occupationId], references: [id], onDelete: Cascade)
  user          UserAccount             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          IntegrationFeePlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments      IntegrationFeePayment[]

  @@index([userId, status])
  @@map("integration_fee_dues")
}

model IntegrationFeePayment {
  id               String               @id @default(uuid()) @db.Uuid
  dueId            String               @map("due_id") @db.Uuid
  transactionId    String               @map("transaction_id") @db.Uuid
  amount           Decimal              @db.Decimal(12, 2)
  paymentMethod    String               @map("payment_method") @db.VarChar(30)
  receiptReference String               @unique @map("receipt_reference") @db.VarChar(80)
  recordedById     String               @map("recorded_by_id") @db.Uuid
  paidAt           DateTime             @default(now()) @map("paid_at") @db.Timestamptz(6)

  due              IntegrationFeeDue    @relation(fields: [dueId], references: [id], onDelete: Restrict)
  transaction      FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  recordedBy       UserAccount          @relation("IntegrationFeeRecordedBy", fields: [recordedById], references: [id])

  @@map("integration_fee_payments")
}

model Donation {
  id            String                @id @default(uuid()) @db.Uuid
  associationId String                @map("association_id") @db.Uuid
  donorName     String                @map("donor_name") @db.VarChar(120)
  donorEmail    String?               @map("donor_email") @db.VarChar(255)
  donorPhone    String?               @map("donor_phone") @db.VarChar(50)
  amount        Decimal               @db.Decimal(12, 2)
  currency      String                @default("XOF") @db.Char(3)
  paymentMethod String                @default("MOBILE_MONEY") @map("payment_method") @db.VarChar(50)
  campaignName  String?               @map("campaign_name") @db.VarChar(120)
  reference     String                @unique @db.VarChar(100)
  transactionId String?               @map("transaction_id") @db.Uuid
  notes         String?               @db.Text
  receivedAt    DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  association   Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([associationId, receivedAt])
  @@map("donations")
}

model Expense {
  id            String                @id @default(uuid()) @db.Uuid
  associationId String                @map("association_id") @db.Uuid
  title         String                @db.VarChar(200)
  category      String                @db.VarChar(100)
  amount        Decimal               @db.Decimal(12, 2)
  currency      String                @default("XOF") @db.Char(3)
  beneficiary   String                @db.VarChar(120)
  paymentMethod String                @default("MOBILE_MONEY") @map("payment_method") @db.VarChar(50)
  status        String                @default("PAID") @db.VarChar(20)
  receiptRef    String?               @map("receipt_ref") @db.VarChar(100)
  transactionId String?               @map("transaction_id") @db.Uuid
  notes         String?               @db.Text
  expenseDate   DateTime              @default(now()) @map("expense_date") @db.Timestamptz(6)
  recordedById  String                @map("recorded_by_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  association   Association           @relation(fields: [associationId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  recordedBy    UserAccount           @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  @@index([associationId, expenseDate])
  @@index([category])
  @@map("expenses")
}

// ------------------------------------------------------------------------------
// DOMAINE 8: AUDIT (Journal immuable - ADR-006 & Section 4)
// ------------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.VarChar(100)
  payload      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// DOMAINE 9: NOTIFICATIONS (Centre de notifications in-app - ADR-002, ADR-011)
// ------------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType @default(INFO)
  title     String           @db.VarChar(150)
  message   String           @db.Text
  data      Json?            @db.JsonB
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// DOMAINE 10: RESIDENCES & LOGEMENTS (ADR-010)
// ------------------------------------------------------------------------------

model Quarter {
  id            String   @id @default(uuid()) @db.Uuid
  associationId String   @map("association_id") @db.Uuid
  name          String   @db.VarChar(120)
  city          String   @db.VarChar(100)
  description   String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  association Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  buildings   Building[]

  @@map("quarters")
}

model Building {
  id                 String   @id @default(uuid()) @db.Uuid
  quarterId          String   @map("quarter_id") @db.Uuid
  name               String   @db.VarChar(100)
  address            String   @db.Text
  landlordName       String   @map("landlord_name") @db.VarChar(120)
  landlordPhone      String?  @map("landlord_phone") @db.VarChar(50)
  landlordIbanOrMomo String?  @map("landlord_iban_or_momo") @db.VarChar(80)
  floorsCount        Int      @default(1) @map("floors_count")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  quarter Quarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  rooms   Room[]
  lease   BuildingLease?

  @@map("buildings")
}

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  buildingId String     @map("building_id") @db.Uuid
  roomNumber String     @map("room_number") @db.VarChar(50)
  capacity   Int        @default(1)
  status     RoomStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  building    Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  occupations RoomOccupation[]

  @@unique([buildingId, roomNumber])
  @@map("rooms")
}

model RoomOccupation {
  id             String           @id @default(uuid()) @db.Uuid
  roomId         String           @map("room_id") @db.Uuid
  occupantUserId String           @map("occupant_user_id") @db.Uuid
  associationId  String           @map("association_id") @db.Uuid
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  isActive       Boolean          @default(true) @map("is_active")
  status         OccupationStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  room              Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  occupant          UserAccount         @relation(fields: [occupantUserId], references: [id], onDelete: Restrict)
  association       Association         @relation(fields: [associationId], references: [id], onDelete: Cascade)
  integrationFeeDue IntegrationFeeDue?

  @@index([occupantUserId, isActive])
  @@index([roomId, isActive])
  @@map("room_occupations")
}

// ------------------------------------------------------------------------------
// DOMAINE 12: EVENEMENTS (Agenda Citoyen, Inscriptions & Rappels)
// ------------------------------------------------------------------------------

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventRegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

model CommunityEvent {
  id              String       @id @default(uuid()) @db.Uuid
  communityId     String       @map("community_id") @db.Uuid
  organizerUserId String       @map("organizer_user_id") @db.Uuid
  title           String       @db.VarChar(200)
  description     String       @db.Text
  location        String       @db.VarChar(255)
  startsAt        DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime     @map("ends_at") @db.Timestamptz(6)
  maxAttendees    Int?         @map("max_attendees")
  status          EventStatus  @default(SCHEDULED)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  community       Community                    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  organizer       UserAccount                  @relation(fields: [organizerUserId], references: [id], onDelete: Cascade)
  registrations   CommunityEventRegistration[]

  @@index([communityId, status])
  @@index([startsAt])
  @@map("community_events")
}

model CommunityEventRegistration {
  id           String                  @id @default(uuid()) @db.Uuid
  eventId      String                  @map("event_id") @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  status       EventRegistrationStatus @default(CONFIRMED)
  registeredAt DateTime                @default(now()) @map("registered_at") @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  event        CommunityEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         UserAccount             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("community_event_registrations")
}


