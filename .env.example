# ==============================================================================
# My Community — Variables d'Environnement de Référence (Développement Local)
# ==============================================================================

# Système & Serveur
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Base de Données PostgreSQL
POSTGRES_DB=my_community
POSTGRES_USER=community_app
POSTGRES_PASSWORD=community_dev_password_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql://community_app:community_dev_password_2026@localhost:5432/my_community?schema=public

# Cache & Sessions (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Clés de Chiffrement & Sécurité JWT (Argon2id & HMAC-SHA256)
JWT_SECRET=my_community_dev_jwt_secret_key_at_least_256_bits_length_secure_random
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=my_community_dev_refresh_token_secret_key_at_least_256_bits
REFRESH_TOKEN_EXPIRATION=7d

# Stockage Objet (S3 / MinIO Local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=mycommunity-private-attachments
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_secret_password
S3_FORCE_PATH_STYLE=true

# Devise par Défaut & Localisation
DEFAULT_CURRENCY=XOF
DEFAULT_LOCALE=fr-BJ
DEFAULT_TIMEZONE=Africa/Porto-Novo
