{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "name": "My Community Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "primary": { "value": "#3730A3", "comment": "Indigo profond - Identité, navigation, boutons principaux" },
      "secondary": { "value": "#7C3AED", "comment": "Violet lumineux - Découverte, accents et éléments actifs" },
      "accent": { "value": "#F97373", "comment": "Corail - Interactions, réactions et éléments expressifs" },
      "deep": { "value": "#171638", "comment": "Indigo nuit - Supports de marque et fonds sombres" }
    },
    "functional": {
      "success": { "value": "#15803D", "comment": "Confirmations et actions réussies" },
      "warning": { "value": "#B45309", "comment": "Avertissements et états transitoires" },
      "error": { "value": "#B91C1C", "comment": "Erreurs et suppressions critiques" }
    },
    "neutral": {
      "light": {
        "canvas": { "value": "#F5F5FA", "comment": "Fond général doux" },
        "surface": { "value": "#FFFFFF", "comment": "Cartes, menus et formulaires" },
        "surfaceSubtle": { "value": "#EEEDF5", "comment": "Surfaces secondaires" },
        "textPrimary": { "value": "#17172A", "comment": "Titres et textes courants" },
        "textSecondary": { "value": "#55556B", "comment": "Descriptions et métadonnées" },
        "border": { "value": "#D9D8E5", "comment": "Séparateurs et contours" },
        "disabled": { "value": "#77778A", "comment": "Éléments et textes désactivés" }
      },
      "dark": {
        "canvas": { "value": "#11111B", "comment": "Fond général très sombre" },
        "surface": { "value": "#1B1B2B", "comment": "Cartes et panneaux" },
        "surfaceSubtle": { "value": "#28283B", "comment": "Surfaces secondaires" },
        "textPrimary": { "value": "#F4F4FA", "comment": "Texte principal sombre" },
        "textSecondary": { "value": "#C1C0D4", "comment": "Texte secondaire sombre" },
        "border": { "value": "#414158", "comment": "Contours et séparateurs sombres" }
      }
    }
  },
  "spacing": {
    "1": { "value": 4, "unit": "px" },
    "2": { "value": 8, "unit": "px" },
    "3": { "value": 12, "unit": "px" },
    "4": { "value": 16, "unit": "px" },
    "6": { "value": 24, "unit": "px" },
    "8": { "value": 32, "unit": "px" },
    "12": { "value": 48, "unit": "px" }
  },
  "radius": {
    "sm": { "value": 6, "unit": "px" },
    "md": { "value": 10, "unit": "px" },
    "lg": { "value": 16, "unit": "px" },
    "xl": { "value": 24, "unit": "px" },
    "pill": { "value": 999, "unit": "px" }
  },
  "typography": {
    "fontFamily": { "value": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
    "weights": {
      "regular": { "value": 400 },
      "medium": { "value": 500 },
      "semibold": { "value": 600 },
      "bold": { "value": 700 }
    },
    "scale": {
      "pageTitle": { "fontSize": 32, "lineHeight": 40, "weight": 700 },
      "sectionTitle": { "fontSize": 24, "lineHeight": 32, "weight": 600 },
      "postTitle": { "fontSize": 18, "lineHeight": 26, "weight": 600 },
      "body": { "fontSize": 15, "lineHeight": 24, "weight": 400 },
      "metadata": { "fontSize": 13, "lineHeight": 18, "weight": 400 },
      "button": { "fontSize": 15, "lineHeight": 22, "weight": 600 }
    }
  },
  "layout": {
    "contentMaxWidth": { "value": 1280, "unit": "px" },
    "feedMaxWidth": { "value": 680, "unit": "px" },
    "sidebarWidth": { "value": 240, "unit": "px" },
    "asideWidth": { "value": 320, "unit": "px" },
    "controlHeight": { "value": 44, "unit": "px" },
    "mobileGutter": { "value": 16, "unit": "px" },
    "desktopGutter": { "value": 24, "unit": "px" }
  },
  "breakpoint": {
    "sm": { "value": 640, "unit": "px" },
    "md": { "value": 768, "unit": "px" },
    "lg": { "value": 1024, "unit": "px" },
    "xl": { "value": 1280, "unit": "px" }
  }
}
